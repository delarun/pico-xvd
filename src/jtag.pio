; JTAG-сдвигатель для XVC.
;
; Пины:  OUT base   = TDI, base+1 = TMS  (out pins, 2)
;        side-set   = TCK
;        IN  base   = TDO
;
; TX FIFO: [N-1], затем ceil(N/16) слов; в каждом 16 пар бит (TDI | TMS<<1), младшие первыми
; RX FIFO: floor(N/32) слов через autopush (порог 32, сдвиг вправо)
;          + одно финальное слово (push): частичное, биты в старших разрядах,
;          либо 0, если N кратно 32.
;
; Такт 7 циклов: TCK низкий 2 (выставляем TDI/TMS), высокий 5.
; Устройство защёлкивает TDI/TMS по подъёму и выставляет TDO по спаду; TDO стабилен
; до следующего спада, поэтому читаем его поздно — через 4 цикла после спада, а не на
; подъёме (через 2): запас на задержку TDO в проводах + 2 такта синхронизатора RP2040.
; Чтение на подъёме давало сдвиг на бит на 12.5 МГц и редкие сбои DAP на 10 МГц.

.program xvc_jtag
.side_set 1 opt

start:
    pull block          side 0      ; N-1
    out x, 32
next_word:
    pull block                      ; 16 пар TDI/TMS
    set y, 15
bit_loop:
    out pins, 2         side 0 [1]  ; c0-1: TCK=0, выставить TDI, TMS
    nop                 side 1 [1]  ; c2-3: TCK=1 (устройство защёлкивает TDI/TMS)
    in pins, 1                      ; c4:   прочитать TDO
    jmp x-- more                    ; c5
    jmp done
more:
    jmp y-- bit_loop                ; c6
    jmp next_word
done:
    push block                      ; дослать хвост (или пустое слово)
    jmp start
